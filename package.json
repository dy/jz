{
  "name": "jz",
  "version": "0.9.2",
  "description": "Compile the numeric JavaScript you already test to lean GC-free WASM — same source, no rewrite, type annotations, or runtime.",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./wasi": {
      "types": "./wasi.d.ts",
      "default": "./wasi.js"
    },
    "./interop": {
      "types": "./interop.d.ts",
      "default": "./interop.js"
    },
    "./transform": {
      "types": "./transform.d.ts",
      "default": "./transform.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "interop.d.ts",
    "wasi.d.ts",
    "transform.d.ts",
    "cli.js",
    "wasi.js",
    "interop.js",
    "layout.js",
    "layout-kinds.js",
    "err-codes.js",
    "transform.js",
    "jzify",
    "src",
    "module",
    "dist/jz.js",
    "dist/interop.js",
    "README.md",
    "jz.svg",
    "bench/bench.svg"
  ],
  "bin": {
    "jz": "cli.js"
  },
  "scripts": {
    "lint:imports": "eslint '*.js' src jzify module",
    "lint:imports:fix": "npm run lint:imports -- --fix",
    "audit:files": "knip --no-progress",
    "test": "node test/index.js",
    "test:opt0": "JZ_TEST_OPTIMIZE=0 node test/index.js",
    "test:opt1": "JZ_TEST_OPTIMIZE=1 node test/index.js",
    "test:opt3": "JZ_TEST_OPTIMIZE=3 node test/index.js",
    "test:wasi": "JZ_TEST_HOST=wasi node test/index.js",
    "test:wasm": "JZ_TEST_TARGET=jz.wasm node test/index.js",
    "test:types": "tsc test/public-types.ts --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022,DOM --skipLibCheck false",
    "test:matrix": "npm test && npm run test:opt0 && npm run test:opt3 && npm run test:wasi",
    "test:bench": "node test/bench.js && node test/ecosystem-perf.js && node test/bench-merge.js",
    "test:claims": "node test/bench-claims.js",
    "test:fuzz": "node test/fuzz.js --count=5000",
    "test:ratchet": "node test/perf-ratchet.js",
    "test:self": "node test/self-compile.js && node test/self-compile-perf.js",
    "test:self:recursive": "npm run build && node scripts/recursive-self-check.mjs",
    "test:kernel-gate": "node scripts/kernel-gate.mjs --build --gate functional,sequences,recursive,memory",
    "test:reach": "node scripts/reachability-probe.mjs",
    "test:porffor-core": "node scripts/porffor-core-adapter.mjs --verify",
    "test:262": "node test/test262.js",
    "test:262:builtins": "node test/test262-builtins.js",
    "test:all": "npm run test:matrix && npm run test:262 && npm run test:262:builtins && npm run test:bench && npm run test:self && npm run test:self:recursive",
    "bench": "node bench/bench.mjs",
    "bench:fuzz": "node scripts/fuzz-bench.mjs",
    "bench:size": "node scripts/bench-size.mjs",
    "bench:compile": "node scripts/bench-compile.mjs",
    "bench:startup": "node scripts/bench-startup.mjs",
    "bench:self": "node scripts/bench-self-compile.mjs",
    "bench:readme": "node scripts/bench-readme.mjs",
    "audit:as": "node scripts/audit-assemblyscript.mjs",
    "build": "npm run build:site && node scripts/build-dist.mjs",
    "build:web": "npm run build:site && node scripts/build-dist.mjs --js-only",
    "build:site": "node scripts/build-site.mjs",
    "build:examples": "node examples/build.mjs all",
    "prepublishOnly": "npm test && npm run test:types && npm run test:self && npm run test:self:recursive && npm run test:claims",
    "prepare": "npm run build",
    "audit:fixpoint": "node scripts/audit-fixpoint.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dy/jz.git"
  },
  "bugs": {
    "url": "https://github.com/dy/jz/issues"
  },
  "homepage": "https://jz.js.org",
  "author": "Dmitry Iv",
  "license": "MIT",
  "dependencies": {
    "subscript": "https://codeload.github.com/dy/subscript/tar.gz/0f65c867269c2dc9c26ac98a7bc91d26c327e9b1",
    "watr": "https://codeload.github.com/dy/watr/tar.gz/33ec51b3952e6c5fd418fce93ac1f8c3ca2db5db"
  },
  "keywords": [
    "javascript",
    "webassembly",
    "compiler",
    "functional",
    "minimal",
    "wasm",
    "aot",
    "simd",
    "wasi",
    "wat",
    "dsp",
    "audio",
    "creative-coding",
    "assemblyscript",
    "porffor",
    "numeric",
    "signal-processing",
    "math",
    "audio-worklet",
    "js-to-wasm",
    "performance"
  ],
  "devDependencies": {
    "esbuild": "^0.28.0",
    "eslint": "^10.10.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.35.1",
    "sprae": "^13.3.8",
    "tst": "^9.4.0",
    "typescript": "^5.8.2",
    "web-audio-api": "^1.5.5"
  }
}
