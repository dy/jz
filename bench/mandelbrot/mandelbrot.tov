// mandelbrot.tov: Tov port of mandelbrot.js (same grid, same iteration cap,
// same checksum). The output buffer is a value array, so render takes it inout.

import { checksumU32, medianUs, printResult } from "../_lib/bench"

const W = 256
const H = 256
const MAX_ITER = 256
const N_RUNS = 21
const N_WARMUP = 5

const X0 = -2.0
const X1 = 0.5
const Y0 = -1.25
const Y1 = 1.25

function render(inout out: int[]) {
  const dx = (X1 - X0) / W
  const dy = (Y1 - Y0) / H
  for (let py = 0; py < H; py++) {
    const cy = Y0 + py * dy
    for (let px = 0; px < W; px++) {
      const cx = X0 + px * dx
      let zx = 0.0
      let zy = 0.0
      let i = 0
      while (i < MAX_ITER) {
        const x2 = zx * zx
        const y2 = zy * zy
        if (x2 + y2 > 4.0) break
        zy = 2 * zx * zy + cy
        zx = x2 - y2 + cx
        i++
      }
      out[py * W + px] = i
    }
  }
}

function main() {
  let out: int[] = []
  for (let i = 0; i < W * H; i++) out.push(0)
  for (let i = 0; i < N_WARMUP; i++) render(&out)

  let samples: f64[] = []
  for (let i = 0; i < N_RUNS; i++) {
    const t0 = performance.now()
    render(&out)
    samples.push(performance.now() - t0)
  }
  printResult(medianUs(&samples), checksumU32(out), W * H, MAX_ITER, N_RUNS)
}
