// dispatch.tov: Tov port of dispatch.js (same 8-operator table, same opcode
// stream, same fold). One data-indexed call site through an array of function
// values. JS's 32-bit integer operators run on u32 values in `int`, masked.

import { medianUs, mix, printResult, xorshift32 } from "../_lib/bench"

const N = 1 << 14
const NOPS = 8
const N_ITERS = 48
const N_RUNS = 21
const N_WARMUP = 5
const M = 0xffffffff

// Math.imul on u32 values: split b so no partial product passes 2^49.
function imul(a: int, b: int): int {
  return (a * (b & 0xffff) + (((a * (b >> 16)) & 0xffff) << 16)) & M
}

const ops: ((x: int, k: int) => int)[] = [
  (x: int, k: int) => (x + k) & M,
  (x: int, k: int) => x ^ k,
  (x: int, k: int) => imul(x, k | 1),
  (x: int, k: int) => (k - x) & M,
  (x: int, k: int) => x ^ (x >> 7) ^ k,
  (x: int, k: int) => ((x << 5) - x + k) & M,
  (x: int, k: int) => (((x << 13) & M) | (x >> 19)) ^ k,
  (x: int, k: int) => (x & k) ^ (x >> 11),
]

// `ks[i] = s >> 3` is an arithmetic shift of the signed state in JS.
function fill(inout code: int[], inout ks: int[]) {
  let s = 0x1234abcd
  for (let i = 0; i < N; i++) {
    s = xorshift32(s)
    const signed = s >= 0x80000000 ? s - 0x100000000 : s
    code[i] = s & (NOPS - 1)
    ks[i] = (signed >> 3) & M
  }
}

function runKernel(code: int[], ks: int[]): int {
  let h = 0x811c9dc5
  for (let it = 0; it < N_ITERS; it++) {
    let x = 0x2545f491 + it
    for (let i = 0; i < N; i++) x = ops[code[i]!]!(x, ks[i]!)
    h = mix(h, x)
  }
  return h
}

function main() {
  let code: int[] = []
  let ks: int[] = []
  for (let i = 0; i < N; i++) {
    code.push(0)
    ks.push(0)
  }
  fill(&code, &ks)
  let cs = 0
  for (let i = 0; i < N_WARMUP; i++) cs = runKernel(code, ks)

  let samples: f64[] = []
  for (let i = 0; i < N_RUNS; i++) {
    const t0 = performance.now()
    cs = runKernel(code, ks)
    samples.push(performance.now() - t0)
  }
  printResult(medianUs(&samples), cs, N * N_ITERS, NOPS, N_RUNS)
}
