// munsell.goose: Goose port of munsell.js (same colors, table, runs and
// checksum): the color-space library's xyY to Munsell conversion, a coarse
// search over the renotation grid refined by Newton steps on hue and chroma.
// The packed renotation table decodes once at start, as the JS does at module
// load, through Goose's base64 module; hypot and cbrt are libm's, bound
// through extern fn (Goose's math module has neither).

import bench from "../_lib";
import math;
import base64;

let N_COLORS = 256;
let N_RUNS = 11;
let N_WARMUP = 2;

extern fn cbrt(x: f64) -> f64;
extern fn hypot(x: f64, y: f64) -> f64;

let MU_COUNTS = "5789:98535789:9753578::9853577899853445689:63234679:731345789:41245679:41235678:612346789:1234678991234678991234678992345678:92456789:936789:;<948;=>>=<848;=>>=;648;=>>=:648;=>=<:647:<<;;95369:;::85368999985357889873356888862356788742456788642457898642467997531579:97531CCA=:7531?AA?;8642=?A@=9642;>@@>:752:<?@?<9639;=??=;738:;==<:7379:;<;963689:;:863678::9853";
let MU_PACK = "";

let MU_WX = 0.31006;        // Illuminant C 2° white chromaticity
let MU_WY = 0.31616;

var mu_cnt: u8[360] = [0; 360];
var mu_off: i32[361] = [0; 361];
var mu_xy: u16[>..];

fn init_tables() {
    for i in 360 {
        mu_cnt[i] = MU_COUNTS[i] - 48;
        mu_off[i + 1] = mu_off[i] + mu_cnt[i];
    }
    var bin: u8[>..] = [];
    if !base64::decode(bin, MU_PACK) { abort("bad renotation table"); }
    for i in bin.len >> 1 { mu_xy.push(bin[i * 2] | bin[i * 2 + 1] as u16 << 8); }
}

fn mu_at(hi: i64, vi: i64, ci: i64) -> f64, f64 {
    let o = (mu_off[hi * 9 + vi] + ci) * 2;
    return mu_xy[o] / 1e4, mu_xy[o + 1] / 1e4;
}

fn mu_cell(hi: i64, vi: i64, c: f64) -> f64, f64 {
    let n: i64 = mu_cnt[hi * 9 + vi];
    if c <= 0 { return MU_WX, MU_WY; }
    let ci = c / 2 - 1;
    let c0 = floor(ci);
    if c0 < 0 {
        let x, y = mu_at(hi, vi, 0);
        let t = c / 2;
        return MU_WX + (x - MU_WX) * t, MU_WY + (y - MU_WY) * t;
    }
    if c0 >= n - 1 { return mu_at(hi, vi, n - 1); }
    let x0, y0 = mu_at(hi, vi, c0 as i64);
    let x1, y1 = mu_at(hi, vi, c0 as i64 + 1);
    let t = ci - c0;
    return x0 + (x1 - x0) * t, y0 + (y1 - y0) * t;
}

fn mu_corner(hi: i64, vi: i64, c: f64, alt: i64) -> f64, f64 {
    let k = if mu_cnt[hi * 9 + vi] != 0 { hi } else if mu_cnt[alt * 9 + vi] != 0 { alt } else { -1 };
    if k < 0 { return MU_WX, MU_WY; }
    return mu_cell(k, vi, c);
}

fn mu_y(v: f64) -> f64 { 1.2219 * v - 0.23111 * pow(v, 2.0) + 0.23951 * pow(v, 3.0) - 0.021009 * pow(v, 4.0) + 0.0008404 * pow(v, 5.0) }

fn mu_v(y: f64) -> f64 {
    var v = 10 * cbrt(max(y, 0.0) / 100);
    for i in 40 {
        let f = mu_y(v) - y;
        let d = 1.2219 - 0.46222 * v + 0.71853 * pow(v, 2.0) - 0.084036 * pow(v, 3.0) + 0.004202 * pow(v, 4.0);
        v -= f / d;
        if abs(f) < 1e-9 { break; }
    }
    return v;
}

fn mu_xyy(h: f64, v: f64, c: f64) -> f64, f64, f64 {
    let yy = mu_y(v);
    if c <= 0 { return MU_WX, MU_WY, yy; }
    let vi0 = max(0.0, min(8.0, floor(v) - 1));
    let vi1 = min(8.0, vi0 + 1);
    let tv = max(0.0, min(1.0, (v - 1) - vi0));
    let hf = ((h - 1e-9) % 100 + 100) % 100 / 2.5 - 1;
    let h0 = (floor(hf) % 40 + 40) % 40;
    let h1 = (h0 + 1) % 40;
    let th = hf - floor(hf);
    let ax, ay = mu_corner(h0 as i64, vi0 as i64, c, h1 as i64);
    let bx, by = mu_corner(h1 as i64, vi0 as i64, c, h0 as i64);
    let cx, cy = mu_corner(h0 as i64, vi1 as i64, c, h1 as i64);
    let dx, dy = mu_corner(h1 as i64, vi1 as i64, c, h0 as i64);
    let x0 = ax + (bx - ax) * th;
    let y0 = ay + (by - ay) * th;
    let x1 = cx + (dx - cx) * th;
    let y1 = cy + (dy - cy) * th;
    return x0 + (x1 - x0) * tv, y0 + (y1 - y0) * tv, yy;
}

fn xyy_munsell(x: f64, y: f64, yy: f64) -> f64, f64, f64 {
    let v = mu_v(yy);
    if hypot(x - MU_WX, y - MU_WY) < 1e-4 { return 0.0, v, 0.0; }
    var h = 0.0;
    var c = 0.0;
    var bd = 0.0;
    var seen = false;
    for hi in 40 {
        var cc = 2;
        while cc <= 38 {
            let fx, fy, fyy = mu_xyy(2.5 * (hi + 1), v, cc);
            let d = pow(fx - x, 2.0) + pow(fy - y, 2.0);
            if !seen || d < bd { h = 2.5 * (hi + 1); c = cc; bd = d; seen = true; }
            cc += 2;
        }
    }
    for it in 60 {
        let fx, fy, fyy = mu_xyy(h, v, c);
        let ex = fx - x;
        let ey = fy - y;
        if hypot(ex, ey) < 1e-8 { break; }
        let hx, hy, hyy = mu_xyy(h + 0.05, v, c);
        let kx, ky, kyy = mu_xyy(h, v, c + 0.05);
        let j00 = (hx - fx) / 0.05;
        let j01 = (kx - fx) / 0.05;
        let j10 = (hy - fy) / 0.05;
        let j11 = (ky - fy) / 0.05;
        let det = j00 * j11 - j01 * j10;
        if abs(det) < 1e-12 { break; }
        let s_h = (j11 * -ex - j01 * -ey) / det;
        let s_c = (-j10 * -ex + j00 * -ey) / det;
        h = ((h + max(-5.0, min(5.0, s_h))) % 100 + 100) % 100;
        c = max(0.0, c + max(-5.0, min(5.0, s_c)));
    }
    return h, v, c;
}

fn sgn(v: f64) -> f64 { if v < 0 { -1.0 } else { 1.0 } }

fn srgb_dec(v: f64) -> f64 {
    let a = abs(v);
    return sgn(v) * (if a > 0.04045 { pow((a + 0.055) / 1.055, 2.4) } else { a / 12.92 });
}

fn xyz_xyy(x: f64, y: f64, z: f64) -> f64, f64, f64 {
    let sum = x + y + z;
    if sum == 0 { return 0.3127, 0.329, y; }
    return x / sum, y / sum, y;
}

fn mk_input(n: i64) -> f64[>..] {
    var out: f64[>..] = [];
    var s: u32 = 0x1234abcd;
    for i in n {
        var c = [0.0; 3];
        for &v in c { s ^= s << 13; s ^= s >> 17; s ^= s << 5; v = srgb_dec(s / 4294967296.0); }
        let x = 100 * (0.41239079926595 * c[0] + 0.35758433938387 * c[1] + 0.18048078840183 * c[2]);
        let y = 100 * (0.21263900587151 * c[0] + 0.71516867876775 * c[1] + 0.072192315360733 * c[2]);
        let z = 100 * (0.019330818715591 * c[0] + 0.11919477979462 * c[1] + 0.95053215224966 * c[2]);
        let cx, cy, cyy = xyz_xyy(x, y, z);
        out.push(cx); out.push(cy); out.push(cyy);
    }
    return out;
}

fn to_munsell(src: f64[:], dst: f64[:], n: i64) {
    for i in n {
        let j = 3 * i;
        dst[j], dst[j + 1], dst[j + 2] = xyy_munsell(src[j], src[j + 1], src[j + 2]);
    }
}

fn main() {
    init_tables();
    let src = mk_input(N_COLORS);
    var dst: f64[>..] = [];
    dst.resize(N_COLORS * 3, 0.0);
    for i in N_WARMUP { to_munsell(src, dst, N_COLORS); }

    var samples = [0.0; N_RUNS];
    for &t in samples {
        let t0 = now_ms();
        to_munsell(src, dst, N_COLORS);
        t = now_ms() - t0;
    }
    print_result(median_us(samples), checksum_f64_near(dst), N_COLORS, 1, N_RUNS);
}
