--- a/src/optimize.js
+++ b/src/optimize.js
@@ -2903,6 +2903,17 @@
   if (isPure(node)) return [['drop', node]]   // pure but trapping: the trap stays
   const op = node[0]
   if (op === 'local.tee' && node.length === 3) return [['local.set', node[1], node[2]]]
+  // A structured if whose arms are all discardable computes nothing observable
+  // once its value is dead: only the condition's effects remain (a tee'd test).
+  if (op === 'if') {
+    const { condIdx, cond } = parseIf(node)
+    if (Array.isArray(cond)) {
+      let armsPure = true
+      for (let i = 1; i < node.length; i++) if (i !== condIdx && !(Array.isArray(node[i]) && isDiscardable(node[i]))) armsPure = false
+      if (armsPure) return dropEffects(cond)
+    }
+    return [['drop', node]]
+  }
   if (isEagerValueOp(op)) {
     const eff = []
     for (let i = 1; i < node.length; i++) eff.push(...dropEffects(node[i]))
