+++ b/test/_families.js
@@ -46,7 +46,7 @@ export const FAMILIES = [
     { name: 'hex and unicode escapes equal their characters', src: `export let f = () => "\\xff" === "ÿ" ? 1 : 0\nexport let k = () => "\\uD83D\\uDE00" === "😀" ? 1 : 0\nexport let u = () => "\\u{1F600}" === "😀" ? 1 : 0`, calls: [['f', [], 1], ['k', [], 1], ['u', [], 1]],
