From 0d96971f978d0d2ed2e11a89e24545e3a2b76ad6 Mon Sep 17 00:00:00 2001
From: "Dmitry Iv." <df.creative@gmail.com>
Date: Sun, 6 Sep 2026 03:13:23 -0400
Subject: [PATCH] String.fromCharCode: a code unit's UTF-8 encoding, not one
 truncated byte
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

String.fromCharCode(c) wrote ToUint16(c) & 0xFF as a single byte, so
fromCharCode(0xff) was an invalid one-byte string unequal to the literal
"ÿ", fromCharCode(0x100) was "\0", and the hosted parser's \xHH and
\uHHHH escapes above 0x7f, decoded through it, differed from native. The
unit is now encoded through __fromCodePoint's UTF-8 writer (1, 2 or 3
bytes); ToUint16 takes NaN and ±∞ as 0, truncates, and wraps mod 2^16
through i64 (exact below 2^63, the |0 boundary). A surrogate unit stays
its own 3-byte sequence, as fromCodePoint writes it, and two arguments
never combine into the 4-byte character their pair names: the byte string
model has no lone code unit to hold, recorded as the contract gap.

test/from-char-code.js: NUL, ASCII endpoints, 0x80/0xff/0x100,
0x7ff/0x800/0xffff, modulo 65536, fractions, negatives, non-finite,
strings, multiple arguments, conversion order and a throwing valueOf, byte
lengths beside code units, and the surrogate gap as it stands. 7 tests,
204 assertions at O0-O3. test/index.js registers the file. The family
corpus case "String.fromCharCode above 0xff" stays red on the native leg:
charCodeAt reads bytes (README, strings), so fromCharCode(0x100).charCodeAt(0)
is 196, the leading byte of the two the unit encodes to, as it is for the
literal; its red note now names that read instead of the truncation.

NOT on the campaign branch: the compiler's own binary-string builders
(module/array.js, object.js, typedarray.js, string.js's pool writers,
number.js, regex.js, math/pow-transcend.js, src/static-data.js,
compile/intern-table.js, wat/assemble/static-data.js) build data chunks
with String.fromCharCode(byte) and count bytes as .length, an idiom that
under self-hosting held only through the truncation this repairs; with it,
the kernel's pool offsets and escaped data would double every byte above
0x7f. Converting those builders to a byte-array pipeline is the change this
repair needs, and it is not a leaf.
---
 module/string.js       | 25 +++++++++++++-----
 test/_families.js      |  2 +-
 test/from-char-code.js | 59 ++++++++++++++++++++++++++++++++++++++++++
 test/index.js          |  1 +
 4 files changed, 80 insertions(+), 7 deletions(-)
 create mode 100644 test/from-char-code.js

diff --git a/module/string.js b/module/string.js
index ba200ee0..522805b6 100644
--- a/module/string.js
+++ b/module/string.js
@@ -2205,14 +2205,27 @@ export default (ctx) => {
         (local.get $sp)))))
     (local.get $s))`)
 
-  // String.fromCharCode(...codes) — variadic; each arg is ToUint16(ToNumber(code))
-  // → a 1-byte string, concatenated left to right (mirrors String.fromCodePoint).
+  // String.fromCharCode(code) → the UTF-8 encoding of the UTF-16 code unit
+  // ToUint16(ToNumber(code)) (22.1.2.1): NaN and ±∞ are 0, a fraction truncates,
+  // the rest is taken mod 2^16 (wrapped through i64: exact below 2^63, the `|0`
+  // boundary). The unit is a code point in [0, 0xFFFF], so __fromCodePoint's
+  // writer encodes it: 1 byte below 0x80, 2 below 0x800, 3 otherwise. A surrogate
+  // unit (0xD800-0xDFFF) is written as its own 3-byte sequence, as fromCodePoint
+  // does; under the byte string model no later unit combines with it, so a pair
+  // given as two arguments is not the 4-byte character the pair names in JS.
+  wat('__fromCharCode', `(func $__fromCharCode (param $x f64) (result f64)
+    (if (i32.or (f64.ne (local.get $x) (local.get $x)) (f64.eq (f64.abs (local.get $x)) (f64.const inf)))
+      (then (return (call $__fromCodePoint (f64.const 0)))))
+    (call $__fromCodePoint (f64.convert_i32_u
+      (i32.and (i32.wrap_i64 (i64.trunc_sat_f64_s (local.get $x))) (i32.const 0xFFFF)))))`)
+
+  // String.fromCharCode(...codes) — variadic; each unit's encoding, concatenated
+  // left to right (mirrors String.fromCodePoint). `toNumF64` performs ToPrimitive
+  // on an object argument, so a throwing valueOf/toString propagates per spec.
   bind('String.fromCharCode', (...codes) => {
     if (codes.length === 0) return emit(['str', ''])
-    // ToUint16(ToNumber(code)): `toNumF64` performs ToPrimitive on an object
-    // argument, so a throwing valueOf/toString propagates per spec. A byte ≥0x80
-    // can't be a 7-bit-ASCII SSO, so __char1byte routes it to a heap 1-byte string.
-    const one = (node) => { inc('__char1byte'); return typed(['call', '$__char1byte', asI32(toNumF64(node, emit(node)))], 'f64') }
+    inc('__fromCharCode')
+    const one = (node) => typed(['call', '$__fromCharCode', toNumF64(node, emit(node))], 'f64')
     let r = one(codes[0])
     for (let i = 1; i < codes.length; i++) {
       inc('__str_concat_raw')
