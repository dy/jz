diff --git a/test/from-char-code.js b/test/from-char-code.js
new file mode 100644
index 00000000..b29a580a
--- /dev/null
+++ b/test/from-char-code.js
@@ -0,0 +1,59 @@
+// String.fromCharCode under the UTF-8 string contract (README: strings are UTF-8
+// bytes; length, indexing and slicing count bytes): each argument is the UTF-16
+// code unit ToUint16(ToNumber(code)), and the result is that unit's UTF-8
+// encoding, the bytes a literal of the same character carries. Byte lengths are
+// stated beside the JS code-unit counts. Surrogates are the representation gap:
+// a unit in 0xD800-0xDFFF is written as its own 3-byte sequence (as
+// String.fromCodePoint writes it), and two such arguments never combine into the
+// 4-byte character their pair names in JS; that is recorded here as the contract
+// stands, not asserted as JS.
+import test from 'tst'
+import { is, ok, throws } from 'tst/assert.js'
+import { compile } from '../index.js'
+import { instantiate } from '../interop.js'
+
+const SRC = `export let one = (c) => String.fromCharCode(c)
+export let two = (a, b) => String.fromCharCode(a, b)
+export let three = (a, b, c) => String.fromCharCode(a, b, c)
+export let none = () => String.fromCharCode()
+export let len = (c) => String.fromCharCode(c).length
+export let same = (c, s) => String.fromCharCode(c) === s ? 1 : 0
+export let point = (c) => String.fromCodePoint(c)
+export let fromString = (s) => String.fromCharCode(s)
+export let throwing = () => String.fromCharCode({ valueOf() { throw new TypeError('bad code') } })
+export let order = () => { let t = ''; const a = { valueOf() { t += 'a'; return 65 } }, b = { valueOf() { t += 'b'; return 66 } }; return String.fromCharCode(a, b) + t }`
+const utf8 = (s) => [...new TextEncoder().encode(s)]
+const run = (level) => instantiate(compile(SRC, { optimize: level }), { memory: 64 }).exports
+
+for (const level of [0, 1, 2, 3]) test(`String.fromCharCode: code units become their UTF-8 encoding (O${level})`, () => {
+  const ex = run(level)
+  // [unit, the JS character, UTF-8 byte length]
+  for (const [c, ch, bytes] of [[0, '\0', 1], [0x41, 'A', 1], [0x7f, '\x7f', 1], [0x80, '\x80', 2], [0xff, 'ÿ', 2], [0x100, 'Ā', 2], [0x7ff, '߿', 2], [0x800, 'ࠀ', 3], [0xffff, '￿', 3], [0x20ac, '€', 3]]) {
+    is(ex.one(c), ch, `fromCharCode(0x${c.toString(16)}) is the character`)
+    is(ex.len(c), bytes, `its length is its ${bytes} UTF-8 bytes (JS: 1 code unit)`)
+    is(ex.same(c, ch), 1, 'and it equals the literal of that character')
+    is(ex.one(c), String.fromCharCode(c), 'as in JS')
+  }
+  is(ex.none(), '', 'no arguments: the empty string')
+  is(ex.two(65, 66), 'AB'); is(ex.three(0x48, 0xe9, 0x21), 'Hé!', 'arguments concatenate left to right')
+})
+
+for (const level of [0, 2]) test(`String.fromCharCode: ToUint16 of every input (O${level})`, () => {
+  const ex = run(level)
+  for (const [c, expected] of [[0x10041, 'A'], [0x1ffff, '￿'], [65.9, 'A'], [-1, '￿'], [-0.5, '\0'], [NaN, '\0'], [Infinity, '\0'], [-Infinity, '\0'], [65536, '\0'], [1e10, String.fromCharCode(1e10)]])
+    is(ex.one(c), expected, `fromCharCode(${c}) takes the unit modulo 65536, truncated, non-finite as 0`)
+  is(ex.fromString('65'), 'A', 'a numeric string converts')
+  is(ex.fromString('x'), '\0', 'a non-numeric string is NaN, so 0')
+  throws(() => ex.throwing(), TypeError, 'a throwing valueOf propagates')
+  is(ex.order(), 'ABab', 'arguments convert left to right, before the result')
+})
+
+test('String.fromCharCode: the surrogate gap, as the byte contract stands (recorded, not JS)', () => {
+  const ex = run(1)
+  // a lone surrogate unit is written as its own 3-byte sequence, the same bytes String.fromCodePoint writes for it
+  is(utf8(ex.one(0xd83d)).length, utf8(ex.point(0xd83d)).length, 'fromCharCode and fromCodePoint agree on a lone surrogate')
+  is(ex.len(0xd83d), 3, 'a lone surrogate unit is three bytes (its own sequence); JS holds one code unit the byte model cannot')
+  // a pair given as two arguments does not combine: 6 bytes, not the 4-byte character
+  is(ex.two(0xd83d, 0xde00) === '😀' ? 1 : 0, 0, 'the pair does not become the character (JS: it does); the representation change this needs is the reduction, not a repair here')
+  is(ex.point(0x1f600), '😀', 'one code point above 0xFFFF encodes as 4 bytes through fromCodePoint')
+})
